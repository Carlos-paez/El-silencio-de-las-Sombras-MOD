<file path="src/main/java/com/elsilente/entity/UmbralEntity.java">
package com.elsilente.entity;

import com.elsilente.registry.ModEntities;
import com.elsilente.registry.ModSounds;
import net.minecraft.core.BlockPos;
import net.minecraft.core.particles.ParticleTypes;
import net.minecraft.network.chat.Component;
import net.minecraft.server.level.ServerBossEvent;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.sounds.SoundSource;
import net.minecraft.util.RandomSource;
import net.minecraft.world.BossEvent;
import net.minecraft.world.damagesource.DamageSource;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.ai.attributes.AttributeSupplier;
import net.minecraft.world.entity.ai.attributes.Attributes;
import net.minecraft.world.entity.ai.goal.FloatGoal;
import net.minecraft.world.entity.ai.goal.MeleeAttackGoal;
import net.minecraft.world.entity.ai.goal.target.NearestAttackableTargetGoal;
import net.minecraft.world.entity.monster.Monster;
import net.minecraft.world.entity.player.Player;
import net.minecraft.world.level.Level;

import java.util.List;

/**
 * EL UMBRAL - jefe final.
 *
 * Limite entre el mundo de los mortales y el mundo de las sombras:
 *  - 300 HP con barra de jefe (ServerBossEvent).
 *  - FASE 1 (>50%): invoca Sombras Debiles (1 cada 5 s, maximo 4 vivas).
 *  - FASE 2 (<=50%): ademas invoca El Silente (1 cada 15 s, maximo 2) y
 *    recibe un 10% mas de dano por golpe.
 *  - Drops garantizados: Trofeo del Umbral y Guadana del Segador (loot table).
 *
 * Solo se invoca con el ritual de medianoche (RitualHandler).
 */
public class UmbralEntity extends Monster {

    private final ServerBossEvent bossEvent = new ServerBossEvent(
            Component.translatable("entity.elsilente.umbral"),
            BossEvent.BossBarColor.PURPLE,
            BossEvent.BossBarOverlay.NOTCHED_10);

    private int shadowSummonTimer = 100;
    private int silenteSummonTimer = 300;
    private boolean phaseTwoRoared = false;

    public UmbralEntity(EntityType<? extends UmbralEntity> type, Level level) {
        super(type, level);
    }

    public static AttributeSupplier.Builder createAttributes() {
        return Monster.createMonsterAttributes()
                .add(Attributes.MAX_HEALTH, 300.0D)
                .add(Attributes.MOVEMENT_SPEED, 0.30D)
                .add(Attributes.ATTACK_DAMAGE, 12.0D)
                .add(Attributes.FOLLOW_RANGE, 64.0D)
                .add(Attributes.KNOCKBACK_RESISTANCE, 1.0D);
    }

    @Override
    protected void registerGoals() {
        this.goalSelector.addGoal(0, new FloatGoal(this));
        this.goalSelector.addGoal(2, new MeleeAttackGoal(this, 1.0D, false));
        this.targetSelector.addGoal(1, new NearestAttackableTargetGoal<>(this, Player.class, true));
    }

    // ---------------------------------------------------------------------------
    // Barra de jefe
    // ---------------------------------------------------------------------------

    @Override
    public void startSeenByPlayer(net.minecraft.server.level.ServerPlayer player) {
        super.startSeenByPlayer(player);
        this.bossEvent.addPlayer(player);
    }

    @Override
    public void stopSeenByPlayer(net.minecraft.server.level.ServerPlayer player) {
        super.stopSeenByPlayer(player);
        this.bossEvent.removePlayer(player);
    }

    // ---------------------------------------------------------------------------
    // Fases e invocaciones
    // ---------------------------------------------------------------------------

    @Override
    public void tick() {
        super.tick();
        if (this.level().isClientSide) {
            return;
        }
        this.bossEvent.setProgress(this.getHealth() / this.getMaxHealth());

        if (--this.shadowSummonTimer <= 0) {
            this.shadowSummonTimer = 100;
            summonShadows();
        }
        if (isPhaseTwo()) {
            if (!this.phaseTwoRoared) {
                this.phaseTwoRoared = true;
                roar();
            }
            if (--this.silenteSummonTimer <= 0) {
                this.silenteSummonTimer = 300;
                summonSilente();
            }
        }
    }

    private boolean isPhaseTwo() {
        return this.getHealth() <= this.getMaxHealth() * 0.5F;
    }

    /** Al 50% de vida recibe un 10% mas de dano por golpe. */
    @Override
    public boolean hurt(DamageSource source, float amount) {
        if (isPhaseTwo()) {
            amount *= 1.1F;
        }
        return super.hurt(source, amount);
    }

    private void roar() {
        this.level().playSound(null, this.blockPosition(), ModSounds.UMBRAL_ROAR.get(),
                SoundSource.HOSTILE, 1.5F, 1.0F);
        if (this.level() instanceof ServerLevel server) {
            server.sendParticles(ParticleTypes.LARGE_SMOKE, this.getX(), this.getY() + 1.2D, this.getZ(),
                    60, 0.7D, 1.0D, 0.7D, 0.04D);
        }
    }

    private void summonShadows() {
        if (this.getTarget() == null) {
            return;
        }
        List<SombraDebilEntity> alive = this.level().getEntitiesOfClass(SombraDebilEntity.class,
                this.getBoundingBox().inflate(40.0D));
        if (alive.size() >= 4) {
            return;
        }
        SombraDebilEntity sombra = ModEntities.SOMBRA_DEBIL.get().create(this.level());
        if (sombra == null) {
            return;
        }
        BlockPos spot = summonSpot();
        sombra.moveTo(spot.getX() + 0.5D, spot.getY(), spot.getZ() + 0.5D,
                this.getRandom().nextFloat() * 360.0F, 0.0F);
        this.level().addFreshEntity(sombra);
        summonFx(spot);
    }

    private void summonSilente() {
        Player target = this.level().getNearestPlayer(this, 64.0D);
        if (target == null || !target.isAlive()) {
            return;
        }
        List<ElSilenteEntity> alive = this.level().getEntitiesOfClass(ElSilenteEntity.class,
                this.getBoundingBox().inflate(40.0D));
        if (alive.size() >= 2) {
            return;
        }
        ElSilenteEntity silente = ModEntities.EL_SILENTE.get().create(this.level());
        if (silente == null) {
            return;
        }
        BlockPos spot = summonSpot();
        silente.moveTo(spot.getX() + 0.5D, spot.getY(), spot.getZ() + 0.5D,
                this.getRandom().nextFloat() * 360.0F, 0.0F);
        this.level().addFreshEntity(silente);
        silente.startChase(target);
        summonFx(spot);
    }

    private void summonFx(BlockPos spot) {
        this.level().playSound(null, spot, ModSounds.UMBRAL_SUMMON.get(),
                SoundSource.HOSTILE, 0.9F, 1.0F);
        if (this.level() instanceof ServerLevel server) {
            server.sendParticles(ParticleTypes.LARGE_SMOKE, spot.getX() + 0.5D, spot.getY() + 0.6D,
                    spot.getZ() + 0.5D, 24, 0.4D, 0.5D, 0.4D, 0.02D);
        }
    }

    /** Punto libre con suelo a 2-4 bloques del jefe para materializar invocaciones. */
    private BlockPos summonSpot() {
        RandomSource random = this.getRandom();
        BlockPos origin = this.blockPosition();
        for (int attempt = 0; attempt < 8; attempt++) {
            double angle = random.nextDouble() * Math.PI * 2.0D;
            int dist = 2 + random.nextInt(3);
            BlockPos candidate = origin.offset(
                    (int) Math.round(Math.cos(angle) * dist), 0, (int) Math.round(Math.sin(angle) * dist));

            BlockPos feet = candidate;
            int guard = 0;
            while (!this.level().getBlockState(feet).getCollisionShape(this.level(), feet).isEmpty()
                    && guard++ < 4) {
                feet = feet.above();
            }
            for (int down = 0; down < 5; down++) {
                BlockPos floor = feet.below(down);
                if (!this.level().getBlockState(floor).getCollisionShape(this.level(), floor).isEmpty()) {
                    BlockPos stand = floor.above();
                    if (this.level().getBlockState(stand).getCollisionShape(this.level(), stand).isEmpty()) {
                        return stand;
                    }
                    break;
                }
            }
        }
        return origin;
    }

    // ---------------------------------------------------------------------------
    // Jefe: no se va nunca
    // ---------------------------------------------------------------------------

    @Override
    public void checkDespawn() {
        // El jefe jamas se desvanece por distancia o dificultad.
    }

    @Override
    public boolean removeWhenFarAway(double distance) {
        return false;
    }

    @Override
    public int getExperienceReward() {
        return 100;
    }
}
</file>

<file path="src/main/java/com/elsilente/event/PresenceHandler.java">
package com.elsilente.event;

import com.elsilente.ElSilenteMod;
import com.elsilente.config.ElSilenteConfig;
import com.elsilente.network.ModNetwork;
import com.elsilente.network.PresenceSyncPacket;
import net.minecraft.core.BlockPos;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.world.entity.player.Player;
import net.minecraftforge.event.TickEvent;
import net.minecraftforge.event.entity.player.PlayerEvent;
import net.minecraftforge.eventbus.api.SubscribeEvent;
import net.minecraftforge.fml.common.Mod;
import net.minecraftforge.network.PacketDistributor;

import java.util.HashMap;
import java.util.Map;
import java.util.UUID;

/**
 * Presencia acumulativa por jugador (0-100): cuanto mas te ha notado el mundo
 * de las sombras, mas intensa es la ambientacion (susurros, niebla,
 * alucinaciones -> PresenceFxHandler en cliente).
 *
 * Fuentes:
 *  - Emboscada de El Silente        +20
 *  - Despertar con pesadilla        +20
 *  - Noche en oscuridad (luz <= 7)  +2 cada 10 s
 *  - Luz >= 8 (antorcha, dia)       -2 cada 10 s
 *  - Dormir sin incidentes          -10
 *
 * El nivel se sincroniza al cliente con PresenceSyncPacket.
 */
@Mod.EventBusSubscriber(modid = ElSilenteMod.MODID)
public class PresenceHandler {

    public static final int MAX = 100;

    private static final Map<UUID, Integer> PRESENCE = new HashMap<>();
    private static final Map<UUID, Long> NEXT_EVAL = new HashMap<>();

    /** Intervalo de evaluacion ambiental: 200 ticks (10 s). */
    private static final long EVAL_INTERVAL = 200L;

    private PresenceHandler() {
    }

    public static int getLevel(Player player) {
        return PRESENCE.getOrDefault(player.getUUID(), 0);
    }

    public static void raise(ServerPlayer player, int amount) {
        if (!ElSilenteConfig.COMMON.presenceEnabled.get()) {
            return;
        }
        int value = Math.min(MAX, getLevel(player) + amount);
        PRESENCE.put(player.getUUID(), value);
        sync(player, value);
    }

    public static void lower(ServerPlayer player, int amount) {
        int value = Math.max(0, getLevel(player) - amount);
        PRESENCE.put(player.getUUID(), value);
        sync(player, value);
    }

    private static void sync(ServerPlayer player, int value) {
        ModNetwork.CHANNEL.send(PacketDistributor.PLAYER.with(() -> player),
                new PresenceSyncPacket(value));
    }

    @SubscribeEvent
    public static void onPlayerLogin(PlayerEvent.PlayerLoggedInEvent event) {
        if (event.getEntity() instanceof ServerPlayer player) {
            sync(player, getLevel(player));
        }
    }

    @SubscribeEvent
    public static void onServerTick(TickEvent.ServerTickEvent event) {
        if (event.phase != TickEvent.Phase.END) {
            return;
        }
        if (!ElSilenteConfig.COMMON.presenceEnabled.get()) {
            return;
        }
        for (ServerPlayer player : event.getServer().getPlayerList().getPlayers()) {
            if (player.isSpectator() || player.isCreative()) {
                continue;
            }
            long now = player.level().getGameTime();
            long next = NEXT_EVAL.computeIfAbsent(player.getUUID(), k -> now + EVAL_INTERVAL);
            if (now < next) {
                continue;
            }
            NEXT_EVAL.put(player.getUUID(), now + EVAL_INTERVAL);

            int before = getLevel(player);
            int delta = evaluate(player);
            int after = Math.max(0, Math.min(MAX, before + delta));
            if (after != before) {
                PRESENCE.put(player.getUUID(), after);
                sync(player, after);
            }
        }
    }

    /** Evalua el entorno del jugador: +2 oscuridad nocturna, -2 luz, -1 calma. */
    private static int evaluate(ServerPlayer player) {
        BlockPos pos = player.blockPosition();
        int light = player.serverLevel().getMaxLocalRawBrightness(pos);
        if (player.level().isNight() && light <= 7) {
            return 2;
        }
        if (light >= 8) {
            return -2;
        }
        return -1;
    }
}
</file>

<file path="src/main/java/com/elsilente/event/RitualHandler.java">
package com.elsilente.event;

import com.elsilente.ElSilenteMod;
import com.elsilente.entity.UmbralEntity;
import com.elsilente.registry.ModEntities;
import com.elsilente.registry.ModItems;
import com.elsilente.registry.ModSounds;
import net.minecraft.core.BlockPos;
import net.minecraft.core.particles.ParticleTypes;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.sounds.SoundEvents;
import net.minecraft.sounds.SoundSource;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.player.Player;
import net.minecraft.world.entity.projectile.ThrownEnderpearl;
import net.minecraft.world.level.block.Blocks;
import net.minecraft.world.level.block.CandleBlock;
import net.minecraft.world.level.block.state.BlockState;
import net.minecraft.world.level.block.state.properties.BlockStateProperties;
import net.minecraft.world.phys.BlockHitResult;
import net.minecraft.world.phys.HitResult;
import net.minecraftforge.event.entity.ProjectileImpactEvent;
import net.minecraftforge.eventbus.api.SubscribeEvent;
import net.minecraftforge.fml.common.Mod;

/**
 * Ritual de invocacion (Fase 2): noche y MEDIANOCHE EXACTA (ventana de +/-600
 * ticks sobre las 18000) + perla de ender lanzada al centro de soul soil
 * rodeado de 8 obsidianas con velas encendidas en las cardinales, con un
 * CORAZON SILENTE empuñado. Invoca al jefe EL UMBRAL y consume el corazon.
 */
@Mod.EventBusSubscriber(modid = ElSilenteMod.MODID)
public class RitualHandler {

    private static final BlockPos[] CARDINALS = {
            new BlockPos(0, 0, -1), new BlockPos(0, 0, 1),
            new BlockPos(1, 0, 0), new BlockPos(-1, 0, 0)
    };

    @SubscribeEvent
    public static void onProjectileImpact(ProjectileImpactEvent event) {
        if (!(event.getProjectile() instanceof ThrownEnderpearl pearl)) {
            return;
        }
        if (!(pearl.level() instanceof ServerLevel level)) {
            return;
        }
        if (!level.isNight()) {
            return;
        }
        // Fase 2: medianoche exacta (ventana de +/-600 ticks sobre las 18000).
        long hora = level.getDayTime() % 24000L;
        if (hora < 17400L || hora > 18600L) {
            return;
        }
        // El invocador debe empuñar un Corazón Silente.
        if (!(pearl.getOwner() instanceof ServerPlayer owner)
                || !owner.getMainHandItem().is(ModItems.CORAZON_SILENTE.get())) {
            return;
        }
        HitResult hit = event.getRayTraceResult();
        if (!(hit instanceof BlockHitResult blockHit)) {
            return;
        }
        BlockPos impact = blockHit.getBlockPos();
        BlockPos center = findRitualCenter(level, impact);
        if (center == null || !isValidRitual(level, center)) {
            return;
        }

        event.setCanceled(true);
        pearl.discard();

        ElSilenteMod.LOGGER.info("[El Silente] Ritual de invocación completado en {} por {}",
                center, pearl.getOwner() instanceof ServerPlayer p ? p.getGameProfile().getName() : "desconocido");

        level.playSound(null, center, SoundEvents.LIGHTNING_BOLT_THUNDER, SoundSource.WEATHER, 1.0F, 1.0F);
        level.sendParticles(ParticleTypes.FLASH, center.getX() + 0.5D, center.getY() + 1.0D,
                center.getZ() + 0.5D, 8, 0.0D, 0.0D, 0.0D, 0.0D);
        level.sendParticles(ParticleTypes.LARGE_SMOKE, center.getX() + 0.5D, center.getY() + 1.0D,
                center.getZ() + 0.5D, 60, 0.6D, 0.6D, 0.6D, 0.03D);

        for (BlockPos offset : CARDINALS) {
            // Las velas van SOBRE la obsidiana de las posiciones cardinales.
            // (Antes se comprobaba en el mismo nivel que la obsidiana, lo que
            // hacía imposible que el ritual se validara nunca.)
            BlockPos candlePos = center.offset(offset).above();
            BlockState state = level.getBlockState(candlePos);
            if (state.getBlock() instanceof CandleBlock && state.hasProperty(BlockStateProperties.LIT)) {
                level.setBlock(candlePos, state.setValue(BlockStateProperties.LIT, false), 3);
            }
        }

        Player summoner = pearl.getOwner() instanceof ServerPlayer serverPlayer ? serverPlayer
                : level.getNearestPlayer(center.getX(), center.getY(), center.getZ(), 16.0D, false);

        // El Corazón Silente se consume en la invocación.
        if (owner.getMainHandItem().is(ModItems.CORAZON_SILENTE.get())) {
            owner.getMainHandItem().shrink(1);
        }

        UmbralEntity boss = ModEntities.UMBRAL.get().create(level);
        if (boss == null) {
            return;
        }
        boss.moveTo(center.getX() + 0.5D, center.getY() + 1.0D, center.getZ() + 0.5D, 0.0F, 0.0F);
        level.addFreshEntity(boss);
        level.playSound(null, center, ModSounds.UMBRAL_ROAR.get(), SoundSource.HOSTILE, 1.5F, 1.0F);
        if (summoner != null) {
            boss.setTarget(summoner);
        }
    }

    private static BlockPos findRitualCenter(ServerLevel level, BlockPos impact) {
        BlockPos best = null;
        double bestDist = Double.MAX_VALUE;
        for (int dx = -4; dx <= 4; dx++) {
            for (int dy = -1; dy <= 1; dy++) {
                for (int dz = -4; dz <= 4; dz++) {
                    BlockPos candidate = impact.offset(dx, dy, dz);
                    if (!level.getBlockState(candidate).is(Blocks.SOUL_SOIL)) {
                        continue;
                    }
                    double dist = candidate.distSqr(impact);
                    if (dist <= 16.0D && dist < bestDist) {
                        bestDist = dist;
                        best = candidate;
                    }
                }
            }
        }
        return best;
    }

    private static boolean isValidRitual(ServerLevel level, BlockPos center) {
        if (!level.getBlockState(center).is(Blocks.SOUL_SOIL)) {
            return false;
        }
        for (int dx = -1; dx <= 1; dx++) {
            for (int dz = -1; dz <= 1; dz++) {
                if (dx == 0 && dz == 0) {
                    continue;
                }
                if (!level.getBlockState(center.offset(dx, 0, dz)).is(Blocks.OBSIDIAN)) {
                    return false;
                }
            }
        }
        for (BlockPos offset : CARDINALS) {
            BlockState state = level.getBlockState(center.offset(offset).above());
            if (!(state.getBlock() instanceof CandleBlock)) {
                return false;
            }
            if (!state.hasProperty(BlockStateProperties.LIT) || !state.getValue(BlockStateProperties.LIT)) {
                return false;
            }
        }
        return true;
    }
}
